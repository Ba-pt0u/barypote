# Modèle traité au démarrage par l'image nginx (envsubst) : ${VARIABLES} = variables d'environnement du conteneur.

# Le proxy Geoapify consomme les crédits de la clé : on limite le débit par visiteur.
limit_req_zone $binary_remote_addr zone=geoapify:1m rate=5r/s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Services disponibles côté serveur (sans jamais révéler les clés).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"places":"${BARYPOTE_PLACES}"}';
    }

    # Proxy Geoapify Places : la clé est ajoutée ici et ne transite jamais par le navigateur.
    location = /api/geoapify/places {
        limit_req zone=geoapify burst=10 nodelay;
        # Résolution DNS à la demande : le conteneur démarre même sans accès Internet.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        set $geoapify_host api.geoapify.com;
        proxy_pass https://$geoapify_host/v2/places?$args&apiKey=${GEOAPIFY_API_KEY};
        proxy_ssl_server_name on;
        proxy_set_header Host api.geoapify.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }

    # Fichiers versionnés par Vite : cache long.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable" always;
        expires 1y;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
