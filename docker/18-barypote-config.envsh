#!/bin/sh
# Prépare les variables utilisées par le modèle nginx (sourcé par l'entrypoint de l'image nginx).
if [ -n "${GEOAPIFY_API_KEY:-}" ]; then
    export BARYPOTE_PLACES=geoapify
    echo "barypote : lieux via Geoapify (clé configurée)"
else
    export BARYPOTE_PLACES=overpass
    echo "barypote : lieux via Overpass (aucune clé GEOAPIFY_API_KEY)"
fi
# Résolveur DNS pour les proxys, si l'entrypoint ne l'a pas déjà déterminé.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
    NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {print ($2 ~ ":") ? "["$2"]" : $2}' /etc/resolv.conf)
    export NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS:-1.1.1.1}"
fi
